# Local secrets for `npm run dev`. Copy to .dev.vars (ignored) and fill in.
# Production values go in Cloudflare secrets: npm run wrangler -- secret put <NAME>
# MODEL is set in wrangler.jsonc. Uncomment to try another provider:model (anthropic, openai or google) and fill in its key.
# MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
